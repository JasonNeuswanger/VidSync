                                                <font key="font" metaFont="smallSystem"/>
                                                <string key="title">When distortion is corrected, the hint lines are curved.  Those curves are drawn as connected, smaller straight line segments of the length specified above.</string>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
